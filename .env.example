# MySQL is the main persistence path demonstrated by this project.
PERSISTENCE_BACKEND=mysql

# Configure these only when PERSISTENCE_BACKEND=mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=campusguide_app
MYSQL_PASSWORD=replace_with_local_password
MYSQL_DATABASE=campusguide_fastapi
MYSQL_POOL_MIN_SIZE=2
MYSQL_POOL_MAX_SIZE=10
ADMIN_API_KEY=
ADMIN_API_KEY_HEADER=X-Admin-Key
AGENT_RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Worker settings are intentionally small so their behavior is easy to observe.
TASK_WORKERS=2
TASK_LEASE_SECONDS=30
TASK_POLL_SECONDS=0.5

# Agent runtime. Deterministic mode works offline and follows the same tool
# loop as a remote model, which keeps tests free from API charges.
AGENT_MAX_STEPS=4
AGENT_TOOL_TIMEOUT_SECONDS=5
AGENT_MODEL_TIMEOUT_SECONDS=20
AGENT_HISTORY_LIMIT=20
AGENT_CONTEXT_MAX_CHARS=12000
AGENT_TOOL_RESULT_MAX_CHARS=8000
AGENT_PROMPT_VERSION=v3
AGENT_MODEL_PROVIDER=deterministic
AGENT_MODEL_BASE_URL=https://api.siliconflow.cn/v1
AGENT_MODEL_API_KEY=replace_with_your_key
AGENT_MODEL_NAME=replace_with_a_tool_calling_model

# Optional embedding provider. Lexical retrieval works without an API key.
RAG_ENABLE_SEMANTIC_SEARCH=false
RAG_RETRIEVAL_VERSION=v4
SILICONFLOW_API_KEY=replace_with_your_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
